; ches_core holds editing semantics only. It must never depend on bonsai,
; bonsai_term, async, notty, or any terminal library.

(library
 (name ches_core)
 (libraries core)
 ; ppx_expect v0.18~preview drops the directory from a test file's path when
 ; registering a test, then rebuilds it at exit from the bare filename plus
 ; -source-tree-root. This trailing `.` (the runner's cwd, where dune copies the
 ; sources) wins over the `..` dune passes. Drop it once ppx_expect is fixed.
 (inline_tests
  (flags
   (:standard -source-tree-root .)))
 (preprocess
  (pps ppx_jane)))
