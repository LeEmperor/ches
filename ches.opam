# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A small modal programmer's editor"
description:
  "Ches is a prototype modal text editor with a UI-independent editing core and a Bonsai_term frontend."
license: "MIT"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2"}
  "tree-sitter" {= "0.1.0"}
  "core"
  "core_unix"
  "async"
  "bonsai"
  "bonsai_term"
  "lsp"
  "jsonrpc"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
