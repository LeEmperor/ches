; ches_app performs I/O for the editor and coordinates the core with the keymap.
; Filesystem access lives here, never in ches_core. Like ches_core and ches_input it
; must not depend on bonsai, bonsai_term, async, notty, or any terminal library.

(library
 (name ches_app)
 (foreign_stubs (language c) (names directory_fs_stubs))
 (libraries ches_error ches_core ches_input ches_highlight ches_highlight_tree_sitter core core_unix)
 (preprocess
  (pps ppx_jane)))
